{% from "../components/atoms/button.njk" import Button %}
{% from "../components/atoms/icon.njk" import Icon %}
{% import "../components/atoms/typography.njk" as typography  %}
{% import "./layouts.njk" as layouts %}

{% call layouts.section('light', 'half') -%}
  {% call layouts.centerContainer('px-4 py-2 flex flex-col items-center pb-30') -%}
        
        <div class="flex flex-col" >
            {{ typography.title(benefits.title) }}
            {{ typography.subTitle(benefits.subTitle) }}
        </div>

        <div class="grid lg:grid-cols-2 lg:flex-1/2 gap-x-15 gap-y-10 md:mt-10">
          {% for item in benefits.bulletPoints %}
          <div class="flex flex-row gap-5 items-center justify-center">
              {{ Icon(item.icon, 'text-rapid-blue fa-3x flex items-center justify-center') }}

              <p class="text-justify" ><strong class="text-lg" >{{item.label}}</strong> {{item.message}}</p>
          </div>
          {% endfor %}
        </div>
  {%- endcall %}
{%- endcall %}
