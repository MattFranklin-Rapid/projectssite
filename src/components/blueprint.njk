
{% from "../components/atoms/button.njk" import Button %}
{% from "../components/atoms/icon.njk" import Icon %}
{% from "../components/atoms/angle.njk" import angle %}
{% import "../components/atoms/typography.njk" as typography  %}
{% import "./layouts.njk" as layouts %}

{% call layouts.section('dark', 'half') -%}
  
  {{angle('top')}}

  {% call layouts.centerContainer('px-4 py-2') -%}

    <div class="text-center">
      
        {{ typography.title(blueprint.title) }}
        {{ typography.subTitle(blueprint.subTitle) }}

    </div>

    <div class="w-full grid-cols-1 grid md:grid-cols-2">
        {% for item in faculties %}
        <div class="flex flex-col gap-4 p-5">
            <!-- <img class="card-large-icon" src="{{item.logo_url}}" /> -->
            {{ Icon(item.icon, 'fa-3x text-rapid-blue') }}
            <h3 class="font-bold text-lg " >{{item.heading}}</h3>
            <p class="text-justify" >{{item.content}}</p>
        </div>
        {% endfor %}
    </div>

    <h4 class="text-center text-lg mt-10">Integrated with the Best of Microsoft</h4>

    {% include "./microsoft_integrations.njk" %}

  {%- endcall %}

  {{angle('bottom')}}

{%- endcall %}
