
{% import "../layouts.njk" as layouts %}
{% from "../atoms/button.njk" import Button %}

{% call layouts.section('light', 'half', 'sm:mb-[-150px] md:mb-[-100px]') -%}
  {% call layouts.centerContainer('flex relative z-10 pt-5 px-4 flex-col md:flex-row sm:pt-10 lg:items-center') -%}
        <div class="flex flex-col md:flex-1/3 lg:flex-1/2 lg:items-start">
          <h5 class="font-light text-rapid-blue uppercase text-center lg:text-left" >{{bookDemo.title}}</h5>
          <h3 class="text-4xl my-5 text-center lg:text-left" ><strong>{{bookDemo.subTitle | safe}}</strong></h3>

          <div class="text-justify" >
            {{ bookDemo.content | safe }}
          </div>

          {{ Button( bookDemo.ctaButton.link,  bookDemo.ctaButton.text , "my-10 w-full flex justify-center lg:w-max") }}
        </div>

        <div class="hidden sm:flex justify-center items-center lg:justify-end lg:flex-1/2" >
          <img 
            class="aspect-auto h-max md:w-auto lg:w-4/5 shadow-sm shadow-black rounded-xl relative z-10"
            src='{{bookDemo.image.src}}' 
            alt="{{bookDemo.image.alt}}" 
          />
        </div>
  {%- endcall %}
{%- endcall %}
