
{# 
   This renders a full width video block
    
   to work correctly it requires a video to
   be added to /src/data/videos.json

   then imported like this

   {% set videoId = "ID_IN_VIDEOS_JSON" %}
   {% include "../path/to/full-width-video.njk" %}

   That video id will be used to find the config in videos.json

#}

{% set video = videos[videoId] %}

<div class='skeleton full-width-video'>
  <iframe 
    src="{{video.src}}&amp;enablejsapi=1" 
    title="{{video.title}}"
    class="full-width-player" 
    frameborder="0" 
    id="full-width-player"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
    referrerpolicy="strict-origin-when-cross-origin" 
    allowfullscreen
  ></iframe>
</div>

<style>
  .full-width-video {
    width: 100%;
    position: relative;
    
    iframe.full-width-player {
      width: 100%;
      aspect-ratio: 16 / 9;
    }


    &::before {
      content: "";
      display: block;
      width: 72px;
      height: 72px;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translateY(-50%);
      opacity: 1;
      background: url(data:image/svg+xml;base64,);
      background-position: center;
      background-repeat: no-repeat;
      z-index: 100;
      transition: ease-in-out 150ms opacity;
      cursor: pointer;
    }

    &::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      right: 0;
      background-image: url("{{video.overlayImageSrc}}");
      background-position: center;
      background-size: cover;
      z-index: 10;
      cursor: pointer;
      transition: ease-in-out 150ms opacity;
    }

    &.playing {
      &::after, 
      &::before {
        opacity: 0;
        pointer-events: none;
      }
    }
  }
</style>

<script>
let player;

// Function that gets called when YouTube API is ready
// This is just "magicly" called by the ifram_api script in the head
function onYouTubeIframeAPIReady() {
  // Initialize the player
  player = new YT.Player('full-width-player', {
    events: {
      'onReady': onPlayerReady,
      'onStateChange': onPlayerStateChange
    }
  });
}


// When player is ready
function onPlayerReady(event) {
  console.log('Fullscreen video is ready');
}

// When player state changes
function onPlayerStateChange(event) {
  // 0 = ended, 1 = playing, 2 = paused, 3 = buffering, 5 = video cued
  if (event.data === 0 || event.data === 2) {
    container.classList.remove('playing');
  }
}

function playVideo() {
  if (player && player.playVideo) {
    player.playVideo();
  }
}

const container = document.querySelector('.full-width-video');

container.addEventListener('click', () => {
  container.classList.add('playing');
  playVideo();
});
</script>
