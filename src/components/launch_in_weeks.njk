
{% from "../components/atoms/button.njk" import Button %}
{% from "../components/atoms/logo.njk" import Logo with context %}
{% from "../components/atoms/icon.njk" import Icon with context %}
{% import "./layouts.njk" as layouts %}

{% call layouts.section('light', 'quarter') %}
  {% call layouts.centerContainer('p-10 justify-stretch rounded-2xl') %}

    <!-- <div class="flex w-full items-center justify-center gap-10 flex-wrap mb-10" > -->
    <!-- </div> -->

    <div class="flex gap-10" >
      <div class="flex-1/2 text-justify text-xl" >
        {% for title in launchInWeeks.titles %}
          <div class="flex items-center gap-2 pb-10" >
            {{ Icon(title.icon, 'fad text-rapid-blue fa-2x') }} 
            <h2 class="text-2xl font-bold" >{{title.title}}</h2>
          </div>
        {% endfor %}

        {{launchInWeeks.content|safe}}
      </div>
      <div>
        <img class="flex-1/2 rounded-2xl shadow-black shadow-md" src="{{launchInWeeks.image.src}}" alt="{{launchInWeeks.image.alt}}" />
      </div>
    </div>

  {% endcall %}
{% endcall %}
