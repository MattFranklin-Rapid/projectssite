
{# 
   This renders a full width video block
    
   to work correctly it requires a video to
   be added to "videos" in /src/data/main.json

   then imported like this

   {% set videoId = "ID_IN_MAIN_JSON" %}
   {% from "../components/youtube-video.njk" import youtubeVideo with context %}

   That video id will be used to find the config in main.json

   and called this this:
   {{ youtubeVideo(videoId, 'CSS CLASS NAMES') }}
#}

{% macro youtubeVideo(videoId, containerClass) %}

{% set video = videos[videoId] %}

<div class='aspect-video {{videoId}}__container relative shadow-sm shadow-black {%  if containerClass != blank %} {{containerClass}} {% endif %} rounded-lg overflow-clip' id="{{ videoId }}__container">
  <iframe 
    src="{{video.src}}&amp;enablejsapi=1" 
    title="{{video.title}}"
    class="youtube__player w-full aspect-video" 
    frameborder="0" 
    id="{{videoId}}"
    referrerpolicy="strict-origin-when-cross-origin" 
    allowfullscreen
  ></iframe>
</div>

<script>

  // There is a script in layout.njk that uses 
  // the id's in globalThis.videos to attach 
  // player APIs to each of the youtube iframes

  // Allowing for multiple on one page

  if (!Array.isArray(globalThis.videos)) {
    globalThis.videos = [];
  }

  globalThis.videos.push("{{videoId}}");

</script>

<style>
.{{videoId}}__container {
    &::before {
      content: "";
      display: block;
      width: 72px;
      height: 72px;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translateY(-50%);
      opacity: 1;
      background: url(data:image/svg+xml;base64,);
      background-position: center;
      background-repeat: no-repeat;
      z-index: 100;
      transition: ease-in-out 150ms opacity;
      cursor: pointer;
    }

    &::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      right: 0;
      background-image: url("{{video.overlayImageSrc}}");
      background-position: center;
      background-size: cover;
      z-index: 10;
      cursor: pointer;
      transition: ease-in-out 150ms opacity;
    }

    &.playing {
      &::after, 
      &::before {
        opacity: 0;
        pointer-events: none;
      }
    }
  }
</style>

{% endmacro %}



